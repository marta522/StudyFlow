datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id_roles Int    @id @default(autoincrement())
  name     String @unique

  users User[]

  @@map("roles")
}

model User {
  id_users      Int      @id @default(autoincrement())
  first_name    String
  last_name     String
  email         String   @unique
  password_hash String
  token_version Int      @default(0)
  phone         String?
  role_id       Int
  status        String   @default("ACTIVE")
  experience    String?
  about_me      String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  role Role @relation(fields: [role_id], references: [id_roles])

  tutor_subjects            TutorSubject[]
  availability              Availability[]
  lessons_as_tutor          Lesson[]             @relation("TutorLessons")
  bookings_as_student       Booking[]            @relation("StudentBookings")
  reviews_given             Review[]             @relation("StudentReviews")
  reviews_received          Review[]             @relation("TutorReviews")
  monthly_grades_received   MonthlyGrade[]       @relation("StudentGrades")
  monthly_grades_given      MonthlyGrade[]       @relation("TutorGrades")
  subject_requests_created  SubjectRequest[]     @relation("TutorRequests")
  subject_requests_reviewed SubjectRequest[]     @relation("AdminReviewedRequests")
  cancelled_lessons         Lesson[]             @relation("LessonCanceller")
  audit_events              AdminAuditLog[]      @relation("AuditActor")
  reported_lesson_issues    LessonIssue[]        @relation("IssueReporter")
  resolved_lesson_issues    LessonIssue[]        @relation("IssueResolver")
  financial_reports         FinancialReport[]
  notifications             Notification[]

  @@map("users")
}

model Subject {
  id_subjects Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  status      String   @default("ACTIVE")
  created_at  DateTime @default(now())

  tutor_subjects   TutorSubject[]
  lessons          Lesson[]
  monthly_grades   MonthlyGrade[]
  subject_requests SubjectRequest[]

  @@map("subjects")
}

model TutorSubject {
  id_tutor_subjects    Int     @id @default(autoincrement())
  tutor_id             Int
  subject_id           Int
  price_per_hour_cents Int     @default(0)
  experience_years     Int?
  description          String?

  tutor   User    @relation(fields: [tutor_id], references: [id_users], onDelete: Cascade)
  subject Subject @relation(fields: [subject_id], references: [id_subjects], onDelete: Cascade)

  @@unique([tutor_id, subject_id])
  @@map("tutor_subjects")
}

model Availability {
  id_availability Int     @id @default(autoincrement())
  tutor_id        Int
  day_of_week     String
  start_time      String
  end_time        String
  is_active       Boolean @default(true)

  tutor User @relation(fields: [tutor_id], references: [id_users], onDelete: Cascade)

  @@map("availability")
}

model Lesson {
  id_lessons   Int       @id @default(autoincrement())
  tutor_id     Int
  subject_id   Int
  lesson_date  DateTime
  start_time   String
  end_time     String
  status       String    @default("SCHEDULED")
  created_by   Int
  cancelled_by Int?
  cancelled_at DateTime?
  homework     String?
  attention    String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  tutor             User    @relation("TutorLessons", fields: [tutor_id], references: [id_users])
  cancelled_by_user User?   @relation("LessonCanceller", fields: [cancelled_by], references: [id_users], onDelete: SetNull)
  subject           Subject @relation(fields: [subject_id], references: [id_subjects])

  bookings       Booking[]
  reviews        Review[]
  monthly_grades MonthlyGrade[]
  issues         LessonIssue[]

  @@index([tutor_id, lesson_date])
  @@map("lessons")
}

model Booking {
  id_bookings  Int      @id @default(autoincrement())
  lesson_id    Int
  student_id   Int
  booking_date DateTime @default(now())
  status       String   @default("CONFIRMED")
  note         String?

  lesson  Lesson @relation(fields: [lesson_id], references: [id_lessons], onDelete: Cascade)
  student User   @relation("StudentBookings", fields: [student_id], references: [id_users])

  attendance Attendance?

  @@index([student_id])
  @@index([lesson_id])
  // SQLite's partial unique index for active bookings is maintained by SQL migration.
  @@map("bookings")
}

model Attendance {
  id_attendance Int      @id @default(autoincrement())
  booking_id    Int      @unique
  present       Boolean  @default(true)
  marked_by     Int
  marked_at     DateTime @default(now())

  booking Booking @relation(fields: [booking_id], references: [id_bookings], onDelete: Cascade)

  @@map("attendance")
}

model Review {
  id_reviews Int      @id @default(autoincrement())
  student_id Int
  tutor_id   Int
  lesson_id  Int?
  rating     Int
  comment    String?
  created_at DateTime @default(now())

  student User    @relation("StudentReviews", fields: [student_id], references: [id_users])
  tutor   User    @relation("TutorReviews", fields: [tutor_id], references: [id_users])
  lesson  Lesson? @relation(fields: [lesson_id], references: [id_lessons])

  @@unique([student_id, lesson_id])
  @@map("reviews")
}

model MonthlyGrade {
  id_monthly_grades Int      @id @default(autoincrement())
  lesson_id         Int?     @unique
  student_id        Int
  tutor_id          Int
  subject_id        Int
  month             Int
  year              Int
  grade             Float
  comment           String?
  created_at        DateTime @default(now())

  student User    @relation("StudentGrades", fields: [student_id], references: [id_users])
  tutor   User    @relation("TutorGrades", fields: [tutor_id], references: [id_users])
  subject Subject @relation(fields: [subject_id], references: [id_subjects])
  lesson  Lesson? @relation(fields: [lesson_id], references: [id_lessons], onDelete: SetNull)

  @@unique([student_id, subject_id, month, year])
  @@map("monthly_grades")
}

model LessonIssue {
  id_lesson_issues Int      @id @default(autoincrement())
  lesson_id        Int
  reporter_id      Int
  title            String
  description      String
  status           String   @default("OPEN")
  admin_note       String?
  resolved_by      Int?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  lesson   Lesson @relation(fields: [lesson_id], references: [id_lessons], onDelete: Cascade)
  reporter User   @relation("IssueReporter", fields: [reporter_id], references: [id_users], onDelete: Cascade)
  resolver User?  @relation("IssueResolver", fields: [resolved_by], references: [id_users], onDelete: SetNull)

  @@index([status, created_at])
  @@index([reporter_id, lesson_id])
  @@map("lesson_issues")
}

model SubjectRequest {
  id_subject_requests Int       @id @default(autoincrement())
  tutor_id            Int
  subject_name        String
  description         String?
  status              String    @default("PENDING")
  subject_id          Int?
  reviewed_by         Int?
  reviewed_at         DateTime?
  created_at          DateTime  @default(now())

  tutor    User     @relation("TutorRequests", fields: [tutor_id], references: [id_users])
  reviewer User?    @relation("AdminReviewedRequests", fields: [reviewed_by], references: [id_users])
  subject  Subject? @relation(fields: [subject_id], references: [id_subjects])

  @@map("subject_requests")
}

model FinancialReport {
  id_financial_reports     Int      @id @default(autoincrement())
  month                    Int
  year                     Int
  generated_by_user_id     Int
  total_student_cost_cents Int      @default(0)
  total_tutor_salary_cents Int      @default(0)
  file_path                String?
  details                  String   @default("[]")
  created_at               DateTime @default(now())

  generated_by User @relation(fields: [generated_by_user_id], references: [id_users])

  @@map("financial_reports")
}

model Notification {
  id_notifications Int       @id @default(autoincrement())
  user_id          Int
  title            String
  message          String
  type             String
  read_at          DateTime?
  created_at       DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id_users], onDelete: Cascade)

  @@index([user_id, read_at, created_at])
  @@map("notifications")
}

model AdminAuditLog {
  id_admin_audit_logs Int      @id @default(autoincrement())
  actor_id            Int?
  action              String
  entity_type         String
  entity_id           Int?
  details             String   @default("{}")
  created_at          DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actor_id], references: [id_users], onDelete: SetNull)

  @@index([created_at, action, entity_type])
  @@map("admin_audit_logs")
}
