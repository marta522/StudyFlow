datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id_roles Int    @id @default(autoincrement())
  name     String @unique

  users User[]

  @@map("roles")
}

model User {
  id_users      Int           @id @default(autoincrement())
  first_name    String
  last_name     String
  email         String        @unique
  password_hash String
  token_version Int           @default(0)
  phone         String?
  role_id       Int
  status        String        @default("ACTIVE")
  experience    String?
  about_me      String?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  role Role @relation(fields: [role_id], references: [id_roles])

  tutor_subjects            TutorSubject[]
  availability              Availability[]
  lessons_as_tutor          Lesson[]          @relation("TutorLessons")
  bookings_as_student       Booking[]         @relation("StudentBookings")
  reviews_given             Review[]          @relation("StudentReviews")
  reviews_received          Review[]          @relation("TutorReviews")
  monthly_grades_received   MonthlyGrade[]    @relation("StudentGrades")
  monthly_grades_given      MonthlyGrade[]    @relation("TutorGrades")
  subject_requests_created  SubjectRequest[]  @relation("TutorRequests")
  subject_requests_reviewed SubjectRequest[]  @relation("AdminReviewedRequests")
  financial_reports         FinancialReport[]

  @@map("users")
}

model Subject {
  id_subjects Int           @id @default(autoincrement())
  name        String
  description String?
  status      String        @default("ACTIVE")
  created_at  DateTime      @default(now())

  tutor_subjects   TutorSubject[]
  lessons          Lesson[]
  monthly_grades   MonthlyGrade[]
  subject_requests SubjectRequest[]

  @@map("subjects")
}

model TutorSubject {
  id_tutor_subjects Int     @id @default(autoincrement())
  tutor_id          Int
  subject_id        Int
  price_per_hour    Float
  experience_years  Int?
  description       String?

  tutor   User    @relation(fields: [tutor_id], references: [id_users], onDelete: Cascade)
  subject Subject @relation(fields: [subject_id], references: [id_subjects], onDelete: Cascade)

  @@map("tutor_subjects")
}

model Availability {
  id_availability Int     @id @default(autoincrement())
  tutor_id        Int
  day_of_week     String
  start_time      String
  end_time        String
  is_active       Boolean @default(true)

  tutor User @relation(fields: [tutor_id], references: [id_users], onDelete: Cascade)

  @@map("availability")
}

model Lesson {
  id_lessons  Int          @id @default(autoincrement())
  tutor_id    Int
  subject_id  Int
  lesson_date DateTime
  start_time  String
  end_time    String
  status      String       @default("SCHEDULED")
  created_by  Int
  homework    String?
  attention   String?
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  tutor   User    @relation("TutorLessons", fields: [tutor_id], references: [id_users])
  subject Subject @relation(fields: [subject_id], references: [id_subjects])

  bookings Booking[]
  reviews  Review[]

  @@map("lessons")
}

model Booking {
  id_bookings  Int           @id @default(autoincrement())
  lesson_id    Int
  student_id   Int
  booking_date DateTime      @default(now())
  status       String        @default("CONFIRMED")
  note         String?

  lesson  Lesson @relation(fields: [lesson_id], references: [id_lessons], onDelete: Cascade)
  student User   @relation("StudentBookings", fields: [student_id], references: [id_users])

  attendance Attendance?

  @@map("bookings")
}

model Attendance {
  id_attendance Int      @id @default(autoincrement())
  booking_id    Int      @unique
  present       Boolean  @default(true)
  marked_by     Int
  marked_at     DateTime @default(now())

  booking Booking @relation(fields: [booking_id], references: [id_bookings], onDelete: Cascade)

  @@map("attendance")
}

model Review {
  id_reviews Int      @id @default(autoincrement())
  student_id Int
  tutor_id   Int
  lesson_id  Int?
  rating     Int
  comment    String?
  created_at DateTime @default(now())

  student User    @relation("StudentReviews", fields: [student_id], references: [id_users])
  tutor   User    @relation("TutorReviews", fields: [tutor_id], references: [id_users])
  lesson  Lesson? @relation(fields: [lesson_id], references: [id_lessons])

  @@unique([student_id, lesson_id])
  @@map("reviews")
}

model MonthlyGrade {
  id_monthly_grades Int      @id @default(autoincrement())
  student_id        Int
  tutor_id          Int
  subject_id        Int
  month             Int
  year              Int
  grade             Float
  comment           String?
  created_at        DateTime @default(now())

  student User    @relation("StudentGrades", fields: [student_id], references: [id_users])
  tutor   User    @relation("TutorGrades", fields: [tutor_id], references: [id_users])
  subject Subject @relation(fields: [subject_id], references: [id_subjects])

  @@map("monthly_grades")
}

model SubjectRequest {
  id_subject_requests Int           @id @default(autoincrement())
  tutor_id            Int
  subject_name        String
  description         String?
  status              String        @default("PENDING")
  subject_id          Int?
  reviewed_by         Int?
  reviewed_at         DateTime?
  created_at          DateTime      @default(now())

  tutor    User     @relation("TutorRequests", fields: [tutor_id], references: [id_users])
  reviewer User?    @relation("AdminReviewedRequests", fields: [reviewed_by], references: [id_users])
  subject  Subject? @relation(fields: [subject_id], references: [id_subjects])

  @@map("subject_requests")
}

model FinancialReport {
  id_financial_reports Int      @id @default(autoincrement())
  month                Int
  year                 Int
  generated_by_user_id Int
  total_student_cost   Float
  total_tutor_salary   Float
  file_path            String?
  details              String   @default("[]")
  created_at           DateTime @default(now())

  generated_by User @relation(fields: [generated_by_user_id], references: [id_users])

  @@map("financial_reports")
}
